---
import Icon from './Icon.astro';
import Shot from './Shot.astro';
import config from '../config.json';
import { md } from '../lib/text';

interface Props { t: any }
const { t } = Astro.props;
const { host, bedrockPort } = config.server;
const L = config.links;

// Только то, что нужно скриптам в браузере.
const clientData = {
  status: { ...config.status },
  text: { ...t.status, copied: t.a11y.copied, copyFailed: t.a11y.copyFailed },
  gallery: { close: t.gallery.close, prev: t.gallery.prev, next: t.gallery.next, galleryTitle: t.gallery.title },
};
const ruleTabs = [
  ['general', t.rules.general],
  ['server', t.rules.server],
  ['discord', t.rules.discord],
] as const;
---
<a class="skip" href="#main">{t.a11y.skip}</a>

<header class="appbar">
  <nav class="appbar__inner" aria-label={t.a11y.nav}>
    <a class="appbar__brand" href="#top">
      <img src="/favicon.png" width="32" height="32" alt="" />
      <span>Hanafubuki</span>
    </a>
    <ul class="appbar__nav">
      {t.nav.map((n: any) => <li><a class="btn btn--text" href={n.href}>{n.label}</a></li>)}
    </ul>
    <a class="btn btn--filled btn--sm appbar__cta" href={L.discord}>{t.hero.apply}</a>
  </nav>
</header>

<section class="hero" id="top" aria-labelledby="hero-title">
  <canvas class="petals" aria-hidden="true"></canvas>
  <div class="hero__inner">
    <img class="hero__logo" src="/logo.svg" width="1024" height="1024" alt={t.a11y.logoAlt} fetchpriority="high" />
    <h1 class="hero__title" id="hero-title">{t.hero.title}</h1>
    <p class="hero__kanji"><span lang="ja">{t.hero.kanji}</span> · {t.hero.kanjiNote}</p>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
    <ul class="chips" role="list">
      {t.hero.chips.map((c: string) => <li class="chip">{c}</li>)}
    </ul>
    <div class="hero__actions">
      <a class="btn btn--filled btn--lg" href={L.discord}>{t.hero.apply}</a>
      <a class="btn btn--outlined btn--lg" href="#join">{t.hero.join}</a>
    </div>
  </div>
</section>

<main id="main">
  <section class="section section--tight" id="status" aria-labelledby="status-title">
    <div class="wrap">
      <h2 id="status-title" class="visually-hidden">{t.status.title}</h2>
      <div class="grid grid--2">
        {[['java', t.status.java, 'desktop'], ['bedrock', t.status.bedrock, 'phone']].map(([key, label, icon]) => (
          <div class="card card--filled status" data-status={key} data-state="loading">
            <div class="status__head">
              <span class="avatar"><Icon name={icon} /></span>
              <span class="status__label">{label}</span>
              <span class="status__chip"><span class="status__dot" aria-hidden="true"></span><span class="status__state">{t.status.loading}</span></span>
            </div>
            <dl class="status__facts">
              <div><dt>{t.status.players}</dt><dd data-field="players">—</dd></div>
              <div><dt>{t.status.version}</dt><dd data-field="version">—</dd></div>
            </dl>
          </div>
        ))}
      </div>
      <p class="caption center">{t.status.updated}</p>
      <noscript><p class="caption center">{t.status.noscript}</p></noscript>
    </div>
  </section>

  <section class="section" id="join" aria-labelledby="join-title">
    <div class="wrap">
      <header class="sh">
        <h2 id="join-title">{t.join.title}</h2>
        <p>{t.join.lead}</p>
      </header>
      <div class="grid grid--2">
        <article class="card card--filled join">
          <div class="join__head"><span class="avatar"><Icon name="desktop" /></span><h3>{t.join.java.title}</h3></div>
          <ol class="join__steps">{t.join.java.steps.map((s: string) => <li set:html={md(s)} />)}</ol>
          <div class="fields">
            <div class="field">
              <div><p class="field__label">{t.join.java.addressLabel}</p><p class="field__value">{host}</p></div>
              <button class="icon-btn" type="button" data-copy={host} aria-label={`${t.join.copy}: ${host}`}><Icon name="copy" /></button>
            </div>
            <p class="caption">{t.join.java.portNote}</p>
          </div>
        </article>
        <article class="card card--filled join">
          <div class="join__head"><span class="avatar"><Icon name="phone" /></span><h3>{t.join.bedrock.title}</h3></div>
          <ol class="join__steps">{t.join.bedrock.steps.map((s: string) => <li set:html={md(s)} />)}</ol>
          <div class="fields">
            <div class="field">
              <div><p class="field__label">{t.join.bedrock.addressLabel}</p><p class="field__value">{host}</p></div>
              <button class="icon-btn" type="button" data-copy={host} aria-label={`${t.join.copy}: ${host}`}><Icon name="copy" /></button>
            </div>
            <div class="field">
              <div><p class="field__label">{t.join.bedrock.portLabel}</p><p class="field__value">{bedrockPort}</p></div>
              <button class="icon-btn" type="button" data-copy={String(bedrockPort)} aria-label={`${t.join.copy}: ${bedrockPort}`}><Icon name="copy" /></button>
            </div>
          </div>
        </article>
      </div>
      <div class="banner">
        <Icon name="lock" />
        <p set:html={md(t.join.note)} />
        <a class="btn btn--text" href={L.discord}>{t.hero.apply}</a>
      </div>
    </div>
  </section>

  <figure class="insert">
    <Shot name={t.inserts.afterJoin} alt={t.shots[t.inserts.afterJoin]} group="insert" sizes="100vw" widths={[640, 960, 1280, 1600]} label={t.gallery.open} />
    <figcaption class="insert__cap">{t.shots[t.inserts.afterJoin]}</figcaption>
  </figure>

  <section class="section section--container" id="features" aria-labelledby="features-title">
    <div class="wrap">
      <header class="sh">
        <h2 id="features-title">{t.features.title}</h2>
        <p>{t.features.lead}</p>
      </header>
      <ul class="grid grid--features" role="list">
        {t.features.items.map((f: any) => (
          <li class="card card--elevated feature">
            <span class="avatar avatar--lg"><Icon name={f.icon} /></span>
            <div>
              <h3>{f.title}</h3>
              {f.text && <p set:html={md(f.text)} />}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <header class="sh">
        <h2 id="gallery-title">{t.gallery.title}</h2>
        <p>{t.gallery.lead}</p>
      </header>
      <ul class="gallery" role="list">
        {t.gallery.items.map((name: string, i: number) => (
          <li class:list={['gallery__item', { 'gallery__item--big': i === 0 }]}>
            <Shot name={name} alt={t.shots[name]} group="gallery" label={t.gallery.open}
              sizes={i === 0 ? '(min-width: 840px) 700px, 100vw' : '(min-width: 840px) 350px, 50vw'} />
            <span class="gallery__cap" aria-hidden="true">{t.shots[name]}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--container" id="rules" aria-labelledby="rules-title">
    <div class="wrap wrap--text">
      <header class="sh">
        <h2 id="rules-title">{t.rules.title}</h2>
        <p>{t.rules.lead}</p>
      </header>
      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label={t.rules.tabsLabel} hidden>
          {ruleTabs.map(([key, r], i) => (
            <button class="tab" type="button" role="tab" id={`tab-${key}`} aria-controls={`rules-${key}`}
              aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{r.tab}</button>
          ))}
        </div>
        {ruleTabs.map(([key, r]) => (
          <div class="card card--outlined rules" id={`rules-${key}`} role="tabpanel" aria-labelledby={`tab-${key}`}>
            <h3>{r.title}</h3>
            {'lead' in r && r.lead && <p class="rules__lead">{r.lead}</p>}
            <ol class="rules__list">{r.items.map((s: string) => <li set:html={md(s)} />)}</ol>
            {'after' in r && r.after && <p class="rules__after">{r.after}</p>}
            {'notes' in r && r.notes?.map((s: string) => <p class="rules__note" set:html={md(s)} />)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <figure class="insert">
    <Shot name={t.inserts.beforePass} alt={t.shots[t.inserts.beforePass]} group="insert" sizes="100vw" widths={[640, 960, 1280, 1600]} label={t.gallery.open} />
    <figcaption class="insert__cap">{t.shots[t.inserts.beforePass]}</figcaption>
  </figure>

  <section class="section" id="pass" aria-labelledby="pass-title">
    <div class="wrap wrap--text">
      <header class="sh">
        <h2 id="pass-title">{t.pass.title}</h2>
      </header>
      {t.pass.text.map((s: string) => <p class="body-lg" set:html={md(s)} />)}

      <h3 class="title-lg">{t.pass.stepsTitle}</h3>
      <ol class="stepper">
        {t.pass.steps.map((s: string) => <li><span class="stepper__label">{s}</span></li>)}
      </ol>
      <p class="muted">{t.pass.stepsAfter}</p>

      <div class="card card--filled form">
        <div class="form__head">
          <h3 id="form-title">{t.pass.formTitle}</h3>
          <button class="btn btn--tonal btn--sm" type="button" data-copy-from="form-text">
            <Icon name="copy" /> {t.pass.copy}
          </button>
        </div>
        <p class="caption">{t.pass.formHint}</p>
        <pre id="form-text" class="form__text" aria-labelledby="form-title" tabindex="0">{t.pass.form}</pre>
      </div>

      <p class="center"><a class="btn btn--filled btn--lg" href={L.discord}><Icon name="discord" /> {t.pass.apply}</a></p>
    </div>
  </section>

  <section class="section section--container" id="map" aria-labelledby="map-title">
    <div class="wrap wrap--text">
      <div class="card card--outlined mapcard">
        <span class="avatar avatar--lg"><Icon name="map" /></span>
        <h2 id="map-title">{t.map.title}</h2>
        <p class="muted">{t.map.text}</p>
        <ul class="mapshots" role="list">
          {t.map.shots.map((name: string) => (
            <li><Shot name={name} alt={t.shots[name]} group="map" sizes="(min-width: 760px) 220px, 33vw" widths={[240, 400, 640]} label={t.gallery.open} /></li>
          ))}
        </ul>
        {config.mapReady ? (
          <p><a class="btn btn--filled" href={L.map}>{t.map.open} <Icon name="open" /></a></p>
        ) : (
          <>
            <p>
              <span class="btn btn--disabled" aria-disabled="true">{t.map.open}</span>
              <span class="chip chip--tertiary">{t.map.soon}</span>
            </p>
            <p class="caption">{t.map.soonNote} <a href={L.mapFallback}>{L.mapFallback.replace(/^https?:\/\//, '')}</a></p>
          </>
        )}
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap wrap--text">
      <header class="sh">
        <h2 id="faq-title">{t.faq.title}</h2>
      </header>
      <div class="faq card card--filled">
        {t.faq.items.map((f: any) => (
          <details>
            <summary><span>{f.q}</span><Icon name="chevron" class="faq__chevron" /></summary>
            <p set:html={md(f.a)} />
          </details>
        ))}
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <img src="/favicon.png" width="40" height="40" alt="" loading="lazy" />
      <div>
        <p class="footer__name">Hanafubuki</p>
        <p class="caption" lang="ja">花吹雪</p>
      </div>
    </div>
    <ul class="footer__links" role="list">
      <li><a class="btn btn--text" href={L.discord}><Icon name="discord" /> {t.footer.discord}</a></li>
      <li><a class="btn btn--text" href={L.github}><Icon name="github" /> {t.footer.github}</a></li>
    </ul>
    <div class="footer__legal">
      <p class="caption"><a href={L.github}>{t.footer.githubNote}</a> · <a href={L.bacap}>{t.footer.credits}</a></p>
      <p class="caption">{t.footer.disclaimer}</p>
    </div>
  </div>
</footer>

<div class="snackbar" role="status" aria-live="polite"></div>

<script type="application/json" id="client-data" set:html={JSON.stringify(clientData)} />

<script>
  import { startPetals } from '../scripts/petals';
  import { startStatus } from '../scripts/status';
  import { initCopy } from '../scripts/copy';
  import { initTabs } from '../scripts/tabs';
  import { initLightbox } from '../scripts/lightbox';
  import { initAppbar } from '../scripts/appbar';

  const data = JSON.parse(document.getElementById('client-data')!.textContent || '{}');
  initCopy(data.text);
  initTabs();
  initLightbox(data.gallery);
  initAppbar();
  startStatus(data.status, data.text);
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.petals');
  if (canvas) startPetals(canvas);
</script>
